`verilator_config

lint_off -rule EOFNEWLINE
line_off -rule PINCONNECTEMPTY
line_off -rule UNUSEDPARAM
lint_off -rule CASEINCOMPLETE

lintoff -rule UNUSEDSIGNAL -file "*" -match "*Bits of signal are not used*"
lintoff -rule UNUSEDSIGNAL -file "*/d_cache.sv" -match "*'bresp_i'*"
lintoff -rule UNUSEDSIGNAL -file "*/d_cache.sv" -match "*'bid_i'*"